{
  "name": "@gole-number-system/gole-tailwind",
  "version": "1.0.0",
  "description": "Tailwind CSS support for the Gole Number System (base 100): the GoleStandard font face, the font-gole utility and the gole classes, for Tailwind v4 and v3.",
  "license": "MIT",
  "author": "eSetu Solutions Pvt Ltd (https://www.esetu.in/)",
  "contributors": [
    "Revelly Ravi"
  ],
  "homepage": "https://github.com/gole-number-system/gole-js/tree/main/packages/gole-tailwind#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gole-number-system/gole-js.git",
    "directory": "packages/gole-tailwind"
  },
  "bugs": {
    "url": "https://github.com/gole-number-system/gole-js/issues"
  },
  "keywords": [
    "gole",
    "gole-number-system",
    "base-100",
    "numerals",
    "tailwindcss",
    "tailwind-plugin",
    "esetu"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "style": "./css/theme.css",
  "exports": {
    ".": {
      "style": "./css/theme.css",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./theme.css": "./css/theme.css",
    "./pua.css": "./css/pua.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@esetu-solutions/gole-number-system-fonts": "^1.0.0"
  },
  "peerDependencies": {
    "tailwindcss": ">=3.4.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@tailwindcss/node": "^4.3.5",
    "@types/node": "^26.6.11",
    "postcss": "^8.5.34",
    "tailwindcss": "^4.3.5",
    "tailwindcss-v3": "npm:tailwindcss@^3.4.19",
    "typescript": "^6.0.3",
    "vitest": "^5.1.2"
  }
}
