{
  "name": "@gole-number-system/react-gole-charts",
  "version": "1.0.0",
  "description": "Recharts components that show axis ticks, tooltips, labels and legends in the Gole Number System (base 100).",
  "license": "MIT",
  "author": "eSetu Solutions Pvt Ltd (https://www.esetu.in/)",
  "contributors": [
    "Revelly Ravi"
  ],
  "homepage": "https://github.com/gole-number-system/gole-js/tree/main/packages/react-gole-charts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gole-number-system/gole-js.git",
    "directory": "packages/react-gole-charts"
  },
  "bugs": {
    "url": "https://github.com/gole-number-system/gole-js/issues"
  },
  "keywords": [
    "gole",
    "gole-number-system",
    "base-100",
    "numerals",
    "react",
    "recharts",
    "charts",
    "esetu"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@gole-number-system/gole-core": "^1.0.0",
    "@gole-number-system/react-gole": "^1.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "recharts": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.2"
  }
}
