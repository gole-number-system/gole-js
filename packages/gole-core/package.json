{
  "name": "@gole-number-system/gole-core",
  "version": "1.0.0",
  "description": "Core logic for the Gole Number System (base 100): pads decimal digits into pairs and converts them for the GoleStandard fonts.",
  "license": "MIT",
  "author": "eSetu Solutions Pvt Ltd (https://www.esetu.in/)",
  "contributors": [
    "Revelly Ravi"
  ],
  "homepage": "https://github.com/gole-number-system/gole-js/tree/main/packages/gole-core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gole-number-system/gole-js.git",
    "directory": "packages/gole-core"
  },
  "bugs": {
    "url": "https://github.com/gole-number-system/gole-js/issues"
  },
  "keywords": [
    "gole",
    "gole-number-system",
    "base-100",
    "numerals",
    "number-formatting",
    "esetu"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./gole.css": "./css/gole.css",
    "./gole-pua.css": "./css/gole-pua.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@esetu-solutions/gole-number-system-fonts": "^1.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.2"
  }
}
